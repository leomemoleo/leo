# MINALIA Parfüm E-Ticaret Platformu
# Environment Configuration

# Database Configuration (Demo - SQLite)
DB_HOST=localhost
DB_NAME=minalia_perfume
DB_USER=root
DB_PASS=
DB_PORT=3306
DB_CHARSET=utf8mb4

# Site Configuration
SITE_URL=http://localhost:8000
ADMIN_URL=http://localhost:8000/admin
SITE_NAME="MINALIA Parfüm"
SITE_TAGLINE="Lüks Parfüm Deneyimi"
SITE_PHONE="+90 212 XXX XX XX"
SITE_EMAIL="info@minalia.com"

# Security
SESSION_LIFETIME=7200
SECURE_COOKIES=false
CSRF_TOKEN_EXPIRE=3600

# Email Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-password
SMTP_FROM_EMAIL=noreply@minalia.com
SMTP_FROM_NAME="MINALIA Parfüm"

# File Upload
MAX_FILE_SIZE=5242880
ALLOWED_IMAGE_TYPES=jpg,jpeg,png,gif,webp
UPLOAD_PATH=/uploads

# Payment Configuration
PAYMENT_MODE=test
PAYMENT_CURRENCY=TRY

# Cache Configuration
CACHE_ENABLED=true
CACHE_LIFETIME=3600

# Debug Mode
DEBUG_MODE=true
ERROR_LOGGING=true
LOG_PATH=/logs

# API Keys (if needed)
GOOGLE_ANALYTICS_ID=
FACEBOOK_PIXEL_ID=
